      "path": "packs/horizon-items",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "horizon-tables",
      "label": "Horizon Tables",
      "type": "RollTable",
      "path": "packs/horizon-tables",
      "ownership": {
        "PLAYER": "NONE",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "packFolders": [

{
  "id": "dh-horizon",
  "title": "Horizon: Journey to Horizon Hex Crawl",
  "description": "Table tools for the Journey to Horizon campaign frame of Daggerheart: Hope & Fear. Builds a hex map of New Valloren on the fly from the campaign's dice tables, runs the journey hex by hex (travel days, encounter dice, ocean weather, rests, Endurance Countdowns), tracks the Soul Echoes and the Doom Track, adds the Locate Soul Echoes downtime move, and brings the Shadowblighted and Terranamancer features, the Vessel of Light and the campaign's roll tables as compendiums.",
  "version": "0.1.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14.370"
  },
  "authors": [
    {
      "name": "emberite",
      "email": "emberite@geeks.gay",
      "url": "https://github.com/emberite"
    }
  ],
  "url": "https://github.com/emberite/dh-horizon",
  "manifest": "https://github.com/emberite/dh-horizon/releases/latest/download/module.json",
  "download": "https://github.com/emberite/dh-horizon/releases/download/v0.1.0/module.zip",
  "bugs": "https://github.com/emberite/dh-horizon/issues",
  "readme": "README.md",
  "license": "LICENSE",
  "relationships": {
    "systems": [
      {
        "id": "daggerheart",
        "type": "system",
        "compatibility": {
          "minimum": "2.12.0"
        }
      }
    ],
    "requires": [
      {
        "id": "daggerheart-hope-and-fear",
        "type": "module",
        "reason": "Provides the Journey to Horizon rules this module links to and the art of its app."
      }
    ],
    "recommends": [
      {
        "id": "dice-so-nice",
        "type": "module",
        "reason": "Encounter dice, ocean weather and Endurance rolls are rolled in 3D."
      }
    ],
    "conflicts": [
      {
        "id": "dh-hotpot",
        "type": "module",
        "reason": "Hotpot is for the Beast Feast campaign frame. Run one campaign frame module at a time."
      },
      {
        "id": "dh-5banners",
        "type": "module",
        "reason": "Five Banners is for the Five Banners Burning campaign frame. Run one campaign frame module at a time."
      },
      {
        "id": "dh-weredragon",
        "type": "module",
        "reason": "Weredragon is for the Reign of the Weredragon campaign frame. Run one campaign frame module at a time."
      }
    ]
  },
  "esmodules": [
    "scripts/main.mjs"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "packs": [
